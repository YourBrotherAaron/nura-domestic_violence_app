# ============================================================================
# Nura / EviSafe deployment secrets  —  copy this file to ".env" and edit.
# ============================================================================
#   cp .env.example .env
# These values are shared by all services in docker-compose.yml. They only need
# to be internally consistent (the services talk to each other by name), so the
# defaults below work as-is for a dev/school deployment. CHANGE the passwords and
# SECRET_KEY before anything you'd consider even semi-public.

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=domestic
POSTGRES_USER=apiserver
POSTGRES_PASSWORD=change-me-postgres

# --- MinIO (object storage) -------------------------------------------------
# MINIO_SECRET_KEY must be at least 8 characters.
MINIO_ACCESS_KEY=evisafe
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=domestic

# --- OpenBao / Vault (secret store) -----------------------------------------
VAULT_TOKEN=change-me-vault-token

# --- Backend JWT signing key ------------------------------------------------
# Generate a long random value, e.g.:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-secret

# --- CORS: origins allowed to call the API from a browser -------------------
# Covers the Vite dashboard (5173-5175) and Expo web (8081/19006) in local dev.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006

# --- Integrity checker ------------------------------------------------------
CHECK_INTERVAL_SECONDS=300

# --- Demo account (created by the seeder; matches dashboard auto-login) ------
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=DemoPass123!
DEMO_FIRST_NAME=Demo
DEMO_LAST_NAME=Reviewer
